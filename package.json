  "scripts": {
    "start": "VITE_IS_LOCAL=true && vite",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "prepare": "husky",
    "test": "jest",
    "test:ci": "jest --watchAll=false --ci --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && jest --watchAll=false --ci --passWithNoTests && eslint \"src/**/*.{ts,tsx}\"",
    "build-mobile": "node ./build-mobile-app.mjs --mode=prod",
    "build-mobile-local": "node ./build-mobile-app.mjs --mode=local",
    "sync-mobile": "node ./scripts/sync-mobile.mjs",
    "android": "node ./scripts/sync-mobile.mjs && npx cap run android",
    "build-new-prod": "VITE_APP_URL=https://smartbox-app.pl VITE_APP_API_URL=https://api.smartbox-app.pl vite build",
    "build-prod": "yarn build-new-prod",
    "build-staging": "yarn build-new-prod",
    "build-ssr": "tsc -p ssr/tsconfig.json",
    "start:ssr": "node ssr/dist/index.js",
    "dev:ssr": "yarn build-ssr && yarn start:ssr"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
